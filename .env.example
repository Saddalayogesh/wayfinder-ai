# Copy this file to `.env` and fill in your values — `docker compose`
# reads `.env` automatically. The only required value is GEMINI_API_KEY
# (the app otherwise boots fully functional with zero paid keys).

# --- Required ----------------------------------------------------------------
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Optional (sensible defaults are shown) -----------------------------------
# Database
MYSQL_DATABASE=ai_trip_planner
MYSQL_USER=tripapp
MYSQL_PASSWORD=tripapp
MYSQL_ROOT_PASSWORD=root

# Caching: "redis" (default in compose) or "simple" (in-memory, no Redis)
CACHE_TYPE=redis

# JWT signing — set a long random value in production
JWT_SECRET=TonncSZLaN4gggtvHuzDet44Uh6YSTF20h12GnSPcmIjow5hdkJDR7CCGE9k4Ta9

# Places provider: "osm" (free, no key) or "google" (needs GOOGLE_PLACES_API_KEY)
PLACES_PROVIDER=osm
GOOGLE_PLACES_API_KEY=
